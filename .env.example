# UNK — Unknown Unknowns Detector Environment Template
# Copy this file to .env.local and populate with your API credentials.
# Do NOT commit actual secrets or API keys to version control.

# NVIDIA NIM API Key (Required for AI analysis engine)
NVIDIA_API_KEY=

# Model configuration
AI_MODEL=openai/gpt-oss-20b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
MAX_INPUT_TOKENS=16000

